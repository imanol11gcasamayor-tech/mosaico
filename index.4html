<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Mosaico">
<title>Mosaico</title>
<style>
:root{--bg:#fff;--fg:#111;--card:#f2f2f5;--ac:#6c3cf0}
@media(prefers-color-scheme:dark){:root{--bg:#0e0e12;--fg:#f2f2f5;--card:#1c1c24}}
*{box-sizing:border-box}
body{margin:0;font-family:-apple-system,system-ui,sans-serif;background:var(--bg);color:var(--fg);padding:max(16px,env(safe-area-inset-top)) 16px max(16px,env(safe-area-inset-bottom))}
h1{font-size:22px;margin:0 0 12px}
.card{background:var(--card);border-radius:14px;padding:12px;margin-bottom:12px}
label.b,button{display:block;width:100%;padding:12px;border:0;border-radius:10px;background:var(--ac);color:#fff;font-size:16px;text-align:center;margin-top:8px}
button.s,label.s{background:transparent;color:var(--ac);border:1.5px solid var(--ac)}
input[type=text]{width:100%;padding:12px;border-radius:10px;border:1px solid #8885;font-size:16px;background:var(--bg);color:var(--fg)}
input[type=file]{display:none}
input[type=range]{width:100%}
small{opacity:.7}
#prev{max-width:90px;border-radius:8px;margin-top:8px;display:none}
#viewer{display:none}
#box{height:62vh;overflow:hidden;position:relative;touch-action:none;background:#000;border-radius:14px}
#cv{position:absolute;left:0;top:0;transform-origin:0 0}
</style>
</head>
<body>
<h1>📸 Mosaico mágico</h1>

<div class="card">
  <b>1. Famoso</b>
  <input type="text" id="name" placeholder="Ej: Cristiano Ronaldo" autocapitalize="words">
  <button id="search">Buscar foto</button>
  <label class="b s" for="manual">…o elegir su foto de mi galería</label>
  <input type="file" id="manual" accept="image/*">
  <img id="prev" alt="">
  <div><small id="st1"></small></div>
</div>

<div class="card">
  <b>2. Mis fotos</b><br><small>Elige cuantas más mejor (300+ ideal)</small>
  <label class="b" for="pics">Seleccionar fotos</label>
  <input type="file" id="pics" accept="image/*" multiple>
  <div><small id="st2">0 fotos</small></div>
</div>

<div class="card">
  <b>3. Ajustes</b><br>
  <small>Detalle (columnas): <span id="v1">40</span></small>
  <input type="range" id="cols" min="20" max="80" value="40">
  <small>Intensidad de color: <span id="v2">35</span>%</small>
  <input type="range" id="tint" min="0" max="70" value="35">
  <button id="go">Crear mosaico</button>
  <div><small id="st3"></small></div>
</div>

<div id="viewer">
  <div id="box"><canvas id="cv"></canvas></div>
  <div class="card" style="margin-top:12px">
    <small>Zoom (o pellizca con los dedos)</small>
    <input type="range" id="zoom" min="0" max="1" step="0.001" value="0">
    <button id="save">Guardar en Fotos / compartir</button>
    <small>Truco: guárdalo y haz zoom en la app Fotos con los dedos.</small>
  </div>
</div>

<script>
const $=id=>document.getElementById(id);
let target=null, files=[];

$('cols').oninput=e=>$('v1').textContent=e.target.value;
$('tint').oninput=e=>$('v2').textContent=e.target.value;

function loadImg(src,cors){return new Promise((ok,ko)=>{const i=new Image();if(cors)i.crossOrigin='anonymous';i.onload=()=>ok(i);i.onerror=ko;i.src=src;});}

async function wiki(lang,q){
  const u=`https://${lang}.wikipedia.org/w/api.php?action=query&generator=search&gsrsearch=${encodeURIComponent(q)}&gsrlimit=5&prop=pageimages&piprop=thumbnail&pithumbsize=600&format=json&origin=*`;
  const r=await (await fetch(u)).json();
  const pages=Object.values((r.query||{}).pages||{}).filter(p=>p.thumbnail).sort((a,b)=>a.index-b.index);
  return pages.length?pages[0].thumbnail.source:null;
}

function setTarget(img){
  target=img;$('prev').src=img.src;$('prev').style.display='block';
}

$('search').onclick=async()=>{
  const q=$('name').value.trim(); if(!q)return;
  $('st1').textContent='Buscando…';
  try{
    let url=await wiki('es',q)||await wiki('en',q);
    if(!url){$('st1').textContent='No encontré foto. Elígela de tu galería.';return;}
    setTarget(await loadImg(url,true));
    $('st1').textContent='Foto encontrada ✔';
  }catch(e){$('st1').textContent='No se pudo buscar (¿la página está alojada online?). Elige la foto de tu galería.';}
};

$('manual').onchange=async e=>{
  const f=e.target.files[0]; if(!f)return;
  setTarget(await loadImg(URL.createObjectURL(f)));
  $('st1').textContent='Foto elegida ✔';
};

$('pics').onchange=e=>{files=[...e.target.files];$('st2').textContent=files.length+' fotos';};

const T=40; // tamaño de cada celda en px

async function thumb(f){
  let src;
  try{src=await createImageBitmap(f);}catch(_){src=await loadImg(URL.createObjectURL(f));}
  const w=src.width||src.naturalWidth,h=src.height||src.naturalHeight;
  const c=document.createElement('canvas');c.width=c.height=T;
  const x=c.getContext('2d');
  const s=Math.min(w,h);
  x.drawImage(src,(w-s)/2,(h-s)/2,s,s,0,0,T,T);
  if(src.close)src.close();
  const d=x.getImageData(0,0,T,T).data;let r=0,g=0,b=0,n=0;
  for(let i=0;i<d.length;i+=16){r+=d[i];g+=d[i+1];b+=d[i+2];n++;}
  return {c,col:[r/n,g/n,b/n]};
}

const nextFrame=()=>new Promise(r=>setTimeout(r,0));

$('go').onclick=async()=>{
  if(!target){$('st3').textContent='Falta la foto del famoso.';return;}
  if(files.length<10){$('st3').textContent='Elige al menos 10 fotos (mejor 300+).';return;}
  const cols=+$('cols').value, tint=+$('tint').value/100;
  const rows=Math.round(cols*target.naturalHeight/target.naturalWidth);
  const th=[];
  for(let i=0;i<files.length;i++){
    try{th.push(await thumb(files[i]));}catch(_){}
    if(i%10==0){$('st3').textContent=`Analizando fotos ${i+1}/${files.length}`;await nextFrame();}
  }
  $('st3').textContent='Montando mosaico…';await nextFrame();

  const sm=document.createElement('canvas');sm.width=cols;sm.height=rows;
  const sx=sm.getContext('2d');sx.drawImage(target,0,0,cols,rows);
  const px=sx.getImageData(0,0,cols,rows).data;

  const cell=Math.min(T,Math.floor(3000/cols));
  const cv=$('cv');cv.width=cols*cell;cv.height=rows*cell;
  const cx=cv.getContext('2d');
  const used=new Array(th.length).fill(0);
  const order=[...Array(cols*rows).keys()].sort(()=>Math.random()-.5);
  const pen=(cols*rows/th.length)*180;

  for(const k of order){
    const r=px[k*4],g=px[k*4+1],b=px[k*4+2];
    let best=0,bs=1e12;
    for(let j=0;j<th.length;j++){
      const c=th[j].col,dr=c[0]-r,dg=c[1]-g,db=c[2]-b;
      const s=dr*dr+dg*dg+db*db+used[j]*pen;
      if(s<bs){bs=s;best=j;}
    }
    used[best]++;
    const x=(k%cols)*cell,y=Math.floor(k/cols)*cell;
    cx.drawImage(th[best].c,x,y,cell,cell);
    if(tint>0){cx.fillStyle=`rgba(${r},${g},${b},${tint})`;cx.fillRect(x,y,cell,cell);}
  }
  $('st3').textContent='Listo ✔';
  $('viewer').style.display='block';
  initView();
  $('viewer').scrollIntoView({behavior:'smooth'});
};

/* ---- Visor con zoom ---- */
let fit=1,z=1,tx=0,ty=0;
const box=$('box'),cv=$('cv');
function apply(){cv.style.transform=`translate(${tx}px,${ty}px) scale(${fit*z})`;}
function initView(){
  const cw=box.clientWidth,ch=box.clientHeight;
  fit=Math.min(cw/cv.width,ch/cv.height);z=1;$('zoom').value=0;
  tx=(cw-cv.width*fit)/2;ty=(ch-cv.height*fit)/2;apply();
}
function zoomAt(nz,cx,cy){
  nz=Math.max(1,Math.min(20,nz));
  const k=nz/z;tx=cx-(cx-tx)*k;ty=cy-(cy-ty)*k;z=nz;
  if(z==1){tx=(box.clientWidth-cv.width*fit)/2;ty=(box.clientHeight-cv.height*fit)/2;}
  $('zoom').value=Math.log(z)/Math.log(20);apply();
}
$('zoom').oninput=e=>zoomAt(Math.pow(20,+e.target.value),box.clientWidth/2,box.clientHeight/2);

const ptr=new Map();let lastD=0;
box.addEventListener('pointerdown',e=>{box.setPointerCapture(e.pointerId);ptr.set(e.pointerId,[e.clientX,e.clientY]);lastD=0;});
box.addEventListener('pointermove',e=>{
  if(!ptr.has(e.pointerId))return;
  const o=ptr.get(e.pointerId);ptr.set(e.pointerId,[e.clientX,e.clientY]);
  const r=box.getBoundingClientRect();
  if(ptr.size==2){
    const [a,b]=[...ptr.values()];
    const d=Math.hypot(a[0]-b[0],a[1]-b[1]);
    if(lastD)zoomAt(z*d/lastD,(a[0]+b[0])/2-r.left,(a[1]+b[1])/2-r.top);
    lastD=d;
  }else if(ptr.size==1&&z>1){tx+=e.clientX-o[0];ty+=e.clientY-o[1];apply();}
});
const up=e=>{ptr.delete(e.pointerId);lastD=0;};
box.addEventListener('pointerup',up);box.addEventListener('pointercancel',up);
box.addEventListener('wheel',e=>{e.preventDefault();const r=box.getBoundingClientRect();zoomAt(z*(e.deltaY<0?1.15:.87),e.clientX-r.left,e.clientY-r.top);},{passive:false});

$('save').onclick=()=>{
  cv.toBlob(async b=>{
    const f=new File([b],'mosaico.png',{type:'image/png'});
    if(navigator.canShare&&navigator.canShare({files:[f]})){try{await navigator.share({files:[f]});return;}catch(_){return;}}
    const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='mosaico.png';a.click();
  },'image/png');
};
</script>
</body>
</html>
